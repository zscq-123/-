# 仅本地虚构数据演示；复制为 .env 后修改密码，绝不提交 .env。
APP_MODE=demo
DEMO_PASSWORD=local-demo-change-me
DATABASE_URL=sqlite:///./data/legal_aid.db
BACKEND_URL=http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
MAX_AGENT_STEPS=40
MAX_SESSION_COST=1.0

# 可选中文录音转写。配置相对 apps/api 的模型路径，并在 PATH 安装 ffmpeg 和 whisper-cli。
SPEECH_MODEL_PATH=
# 可选加速实时字幕。该目录包含中文 Zipformer 的三个 INT8 ONNX 文件和 tokens.txt。
SPEECH_PREVIEW_MODEL_DIR=

# 默认采用规则模式。下面是 DeepSeek Flash 示例，请仅在本地 .env 填入密钥。
MODEL_MODE=deterministic
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
MODEL_EXTERNAL_CONSENT=false
# 每百万 tokens 的估算单价，启用时按供应商最新报价核对。以下为美元峰时估算。
MODEL_INPUT_PRICE=0.30
MODEL_OUTPUT_PRICE=1.20
