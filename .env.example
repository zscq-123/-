# 仅本地虚构数据演示；复制为 .env 后修改密码，绝不提交 .env。
APP_MODE=demo
DEMO_PASSWORD=local-demo-change-me
DATABASE_URL=sqlite:///./data/legal_aid.db
BACKEND_URL=http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
MAX_AGENT_STEPS=40
MAX_SESSION_COST=1.0

# 默认不请求任何外部模型。外部模式需要机构的数据处理授权；未做真实供应商联调。
MODEL_MODE=deterministic
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_EXTERNAL_CONSENT=false
# 每百万 tokens 的估算单价，币种与供应商报价一致；不是实际账单。
MODEL_INPUT_PRICE=0
MODEL_OUTPUT_PRICE=0
